{
  "$schema": "http://json.schemastore.org/template",
  "author": "Leonardo Henrique da Rocha Araujo",
  "classifications": [ "Web", "CleanArchitecture" ],
  "identity": "CleanArchitecture.Template",
  "name": "Clean Architecture Template (API)",
  "shortName": "clean-arch-api",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "SolutionNamePlaceholder",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/",
        "**/[Oo]bj/",
        ".git/**", 
        ".gitignore", 
        ".gitattributes", 
        ".gitmodules"
      ]
    }
  ],
  "symbols": {
    "ProjectName": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "SolutionNamePlaceholder",
      "isRequired": true,
      "fileRename": "SolutionNamePlaceholder",
      "description": "The root namespace/project name"
    }
  }
}
